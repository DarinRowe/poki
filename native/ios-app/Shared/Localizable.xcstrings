    },
    "Copy Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝地址"
          }
        }
      }
    },
    "Copy Log": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝日志"
          }
        }
      }
    },
    "Copy the line below.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝下方配置。"
          }
        }
      }
    },
    "Denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
      }
    },
    "Deny": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
