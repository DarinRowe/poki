{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在“%2$@”中%1$@"
          }
        }
      }
    },
    "%@ in %@. Open Poki to allow or deny.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“%2$@”中%1$@。打开 Poki 允许或拒绝。"
          }
        }
      }
    },
    "%@ or later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 或更高版本"
          }
        }
      }
    },
    "%@, %lld missed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld 步失败"
          }
        }
      }
    },
    "%@, Step %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，第 %lld 步"
          }
        }
      }
    },
    "%@. Started at %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。始于%2$@。"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        }
      }
    },
    "%lld lines": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 行"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld"
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 点"
          }
        }
      }
    },
    "%lld s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "%lld steps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 步"
          }
        }
      }
    },
    "%lld steps in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 步，用时 %2$@"
          }
        }
      }
    },
    "1 link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个链接"
          }
        }
      }
    },
    "1 minute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分钟"
          }
        }
      }
    },
    "1 step": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 步"
          }
        }
      }
    },
    "2 minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分钟"
          }
        }
      }
    },
    "30 seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒"
          }
        }
      }
    },
    "5 minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分钟"
          }
        }
      }
    },
    "ADDRESSES": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络地址"
          }
        }
      }
    },
    "AGENTS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体"
          }
        }
      }
    },
    "About 5 minutes. Everything stays on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约需 5 分钟。所有数据均保留在此 iPhone 上。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add it to the tun inbound in your sing-box profile, then reload the profile.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将其添加到 sing-box 配置的 tun 入站中，然后重新加载配置。"
          }
        }
      }
    },
    "Add this URL as a remote MCP server in your client. Anyone with this link can control this iPhone while Poki is running. Keep it private, and revoke it here if compromised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在客户端中将此地址添加为远程 MCP 服务器。Poki 运行期间，任何持有此地址的人都能控制此 iPhone。请妥善保管，如有泄露请在此处撤销。"
          }
        }
      }
    },
    "Add your agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加智能体"
          }
        }
      }
    },
    "Added": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加日期"
          }
        }
      }
    },
    "After restarting, unlock this iPhone and tap **Turn On**.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动后，解锁此 iPhone 并轻点“**打开**”。"
          }
        }
      }
    },
    "Agent finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体已完成"
          }
        }
      }
    },
    "Agents can reach this iPhone, but Poki can’t tap until Loopback is on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体已可连接此 iPhone，但开启回环后 Poki 才能执行轻点。"
          }
        }
      }
    },
    "Agents can’t reach this iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体无法连接此 iPhone"
          }
        }
      }
    },
    "All Steps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有步骤"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        }
      }
    },
    "Allow Location Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问位置信息"
          }
        }
      }
    },
    "Allow UI Automation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 UI 自动化"
          }
        }
      }
    },
    "Allow action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许操作"
          }
        }
      }
    },
    "Allow location access for Poki (Settings › Poki › Location › Always). Poki uses it only to keep running; it never records where you are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 Poki 访问位置信息（设置 › Poki › 位置 › 始终）。Poki 仅用它保持运行，绝不记录你的位置。"
          }
        }
      }
    },
    "Allow this step?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许这一步吗？"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "Allows Poki Runner to control other apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Poki Runner 操作其他 App。"
          }
        }
      }
    },
    "Allows Poki to reach this iPhone’s developer services through your proxy app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Poki 通过你常用的代理 App 连接此 iPhone 的开发者服务。"
          }
        }
      }
    },
    "Allows this iPhone to run Poki Runner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此 iPhone 运行 Poki Runner。"
          }
        }
      }
    },
    "Almost Ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将就绪"
          }
        }
      }
    },
    "Approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准"
          }
        }
      }
    },
    "Approval Required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要批准"
          }
        }
      }
    },
    "BACKGROUND HOLD": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台保活"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "CHECKS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查"
          }
        }
      }
    },
    "Cancel Pairing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配对"
          }
        }
      }
    },
    "Checking 10.7.0.1 every few seconds…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔几秒检查一次 10.7.0.1…"
          }
        }
      }
    },
    "Checking pairing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查配对"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "Claude, Codex, and other MCP clients tap and type for you. You see every step and approve anything sensitive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、Codex 等 MCP 客户端替你轻点和输入。每一步都清晰可见，敏感操作须经你批准。"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Connect to Wi-Fi: the developer services need it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接无线局域网，开发者服务需要它。"
          }
        }
      }
    },
    "Connect to Wi‑Fi and tap **Start Pairing**. Allow local network access when prompted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接无线局域网并轻点“**开始配对**”。出现提示时，请允许访问本地网络。"
          }
        }
      }
    },
    "Connected": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "Connecting": {
      "localizations": {
