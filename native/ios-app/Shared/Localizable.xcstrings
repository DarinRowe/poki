    "Deny action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝操作"
          }
        }
      }
    },
    "Developer Disk Image Ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者磁盘映像已就绪"
          }
        }
      }
    },
    "Developer Mode is on": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启开发者模式"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Don’t Allow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许"
          }
        }
      }
    },
    "Don’t open Poki Runner yourself. Poki starts it when an agent needs this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿手动打开 Poki Runner。智能体需要使用此 iPhone 时，Poki 会自动启动它。"
          }
        }
      }
    },
    "Download Again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新下载"
          }
        }
      }
    },
    "Download Developer Disk Image": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载开发者磁盘映像"
          }
        }
      }
    },
    "Downloading Developer Disk Image: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载开发者磁盘映像：%@"
          }
        }
      }
    },
    "Enter the code shown here and on the Lock Screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入此处或锁定屏幕上显示的配对码。"
          }
        }
      }
    },
    "Enter the passcode if the iPhone asks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 要求时请输入锁屏密码"
          }
        }
      }
    },
    "Enter this code in Settings. It also appears on the Lock Screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中输入此配对码。配对码也会显示在锁定屏幕上。"
          }
        }
      }
    },
    "Enter your relay's address first (Settings › Relay). Poki has no default relay.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置 › 中转”中输入你的中转地址。Poki 没有默认中转。"
          }
        }
      }
    },
    "Experiment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验模式"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败"
          }
        }
      }
    },
    "Finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "Finished in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在“%@”中完成"
          }
        }
      }
    },
    "Fix the item below so your agents can use this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理下方问题后，智能体即可使用此 iPhone。"
          }
        }
      }
    },
    "Free on the App Store": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 免费提供"
          }
        }
      }
    },
    "Get LocalDevVPN on the App Store": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 App Store 获取 LocalDevVPN"
          }
        }
      }
    },
    "Gives Poki its own key to this iPhone. The key stays on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Poki 生成访问此 iPhone 的专属密钥。密钥仅保留在本机上。"
          }
        }
      }
    },
    "Go to Settings › Other and turn on Include route 10.7.0.1/32 (update Shadowrocket if missing).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往“设置 › 其他”并开启“包含路由 10.7.0.1/32”（若无此选项请更新 Shadowrocket）。"
          }
        }
      }
    },
    "Home Screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主屏幕"
          }
        }
      }
    },
    "IPv6 present: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 IPv6：%@"
          }
        }
      }
    },
    "Idle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲"
          }
        }
      }
    },
    "Import Pairing File": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入配对文件"
          }
        }
      }
    },
    "In Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
