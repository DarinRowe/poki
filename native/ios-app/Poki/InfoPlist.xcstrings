    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Poki connects to this iPhone's own developer services to pair with it and to run the automation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki 会连接此 iPhone 自身的开发者服务，用于配对和运行自动化。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Poki keeps running in the background while it is on, so agents can reach this iPhone. Poki does not record or send your location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki 开启时会在后台保持运行，让智能体能连上此 iPhone。Poki 不会记录或发送你的位置。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Poki keeps running in the background while it is on, so agents can reach this iPhone. Poki does not record or send your location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Poki 开启时会在后台保持运行，让智能体能连上此 iPhone。Poki 不会记录或发送你的位置。"
          }
        }
      }
    }
  },
  "version": "1.0"
